NODE_ENV=development
PORT=4000

# Postgres connection string (see db/schema.sql for the schema this expects)
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/career_guidance
# Secret used for session/JWT signing. The value below is a PLACEHOLDER
# and is rejected outright when NODE_ENV=production — the backend refuses
# to start rather than sign tokens with a value published in this repo
# (see backend/src/config/env.js). In production it must be set
# explicitly, must not be a known placeholder, and must be at least 32
# characters. Generate one with:
#     openssl rand -base64 48
AUTH_SECRET=change-me-in-every-environment

# Where the Python ML microservice is reachable
ML_SERVICE_URL=http://localhost:8000

# Job-market integration (see job_api.py in the legacy app)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

ML_SERVICE_TIMEOUT_MS=10000
ADZUNA_COUNTRY=in

# Storage abstraction (section 27) — local for native/dev, s3 in AWS.
# STORAGE_DRIVER=s3 requires S3_BUCKET_NAME (+ the task's IAM role
# granting s3:PutObject/GetObject on that bucket — see
# infrastructure/terraform/modules/iam and docs/AWS_ARCHITECTURE.md).
# AWS_REGION and credentials are provided by the EC2 instance's IAM role
# in production — never set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY here.
#
# Stored resumes are private under BOTH drivers: there is no static file
# route, and the only way to read one is the authenticated
# GET /api/resume/download endpoint.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PRESIGNED_URL_TTL_SECONDS=900

# Comma-separated list of allowed frontend origins for CORS. Leave
# empty in local dev (any origin is allowed then). Required in
# production — e.g. the S3 static website URL or CloudFront domain.
CORS_ALLOWED_ORIGINS=

# Max size (MB) accepted for an uploaded resume file at POST /resume/upload.
RESUME_UPLOAD_MAX_MB=5

# --- Rate limiting (backend/src/middleware/rateLimit.js) ---------------
# In-process fixed-window limiting on auth, uploads, skill extraction,
# recommendations, skill tests, and the job/trend endpoints. Counters are
# per-process: correct for the current single-container deployment, but
# they are NOT shared if the backend is ever scaled to multiple
# instances (move the limit to Redis or the load balancer if so).
#
# Set to false only for local load-testing.
RATE_LIMIT_ENABLED=true

# Scales every configured limit at once (e.g. 2 = double all buckets).
RATE_LIMIT_MULTIPLIER=1

# How many reverse proxies sit in front of Express. 1 for the nginx-based
# EC2 deployment, 0 when running the backend directly. Required for rate
# limiting to key on the real client IP rather than the proxy's.
TRUST_PROXY_HOPS=0
