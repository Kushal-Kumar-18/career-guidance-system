# Production frontend image for the EC2/Docker Compose deployment
# (docker-compose.prod.yml). Unlike the local-dev Dockerfile (which uses
# `serve` on :4173 for local Docker testing), this image serves the
# static build directly via Nginx on :80 and reverse-proxies /api and
# /files to the backend container — this IS the "Nginx" component of
# the AWS architecture (see docs/AWS_ARCHITECTURE.md), not a separate
# server. Not build-tested in this sandbox (no Docker daemon here).
FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

# Relative — the browser calls same-origin `/api/...`
# (frontend/src/services/api.js builds requests as `${API_BASE}/api${path}`,
# so API_BASE must be EMPTY here, not "/api" — setting it to "/api" would
# produce a double "/api/api/..." prefix) and THIS Nginx container proxies
# that to the backend container (see nginx.conf). This means the image
# never needs to know the EC2 instance's public IP or domain name, so it
# never needs rebuilding if that changes.
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
