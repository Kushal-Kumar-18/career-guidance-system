# Read automatically by `docker compose` (both docker-compose.yml and
# docker-compose.prod.yml) from a file literally named `.env` in this
# directory — copy this to `.env` and fill in real values before running
# `docker compose -f docker-compose.prod.yml up -d --build` on the EC2
# instance. Never commit the real `.env`.
#
# This is separate from backend/.env and ml-service/.env, which hold
# each service's own application configuration (see their own
# .env.example files) — this file only supplies the Postgres
# credentials that both the `postgres` and `backend` services in
# docker-compose.prod.yml need to agree on.

POSTGRES_USER=career_guidance_app
POSTGRES_PASSWORD=kushal18
