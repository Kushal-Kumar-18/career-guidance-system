ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Path to the feedback-calibration model file (see app/engine/feedback_model.py).
# This is NOT a pretrained "career suitability" model - it's a small model
# that only trains once enough real user feedback ratings have been
# recorded, and the engine works fine without it (falls back to the
# transparent, rule-based fit score). Defaults to
# app/data/ml_models/feedback_calibration_model.pkl relative to this
# service if unset.
ML_MODEL_PATH=app/data/ml_models/feedback_calibration_model.pkl

# --- Feedback storage (see app/storage/feedback_store.py) -------------
# Feedback ratings are the ONLY training data this service has, and they
# cannot be regenerated. With the default `json` driver they live in a
# file inside the container, which is wiped whenever the container is
# recreated unless that path is on a mounted volume (docker-compose.yml
# mounts one). Set this to `postgres` in any real deployment so ratings
# are stored in the same database as everything else.
FEEDBACK_STORE=json

# Connection string used when FEEDBACK_STORE=postgres. Falls back to
# DATABASE_URL if unset.
FEEDBACK_DATABASE_URL=

# Directory holding the JSON feedback log and the trained calibration
# model. Mount this on a volume if you keep FEEDBACK_STORE=json.
ML_MODEL_DIR=app/data/ml_models
